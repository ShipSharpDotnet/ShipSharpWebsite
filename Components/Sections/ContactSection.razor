@inject IJSRuntime JS
@implements IDisposable

<!-- ========================================================= -->
<!-- CONTACT / HIRE ME SECTION                                 -->
<!-- ========================================================= -->
<section id="contact" class="py-20 sm:py-28 border-t border-white/5">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="relative rounded-3xl bg-navy-800/70 backdrop-blur-xl border border-white/10 p-8 sm:p-12 text-center overflow-hidden shadow-2xl">
            <!-- Top Gradient Accent -->
            <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-brand-cyan via-brand-mint to-brand-magenta"></div>

            <p class="font-mono text-xs sm:text-sm uppercase tracking-widest text-brand-cyan font-semibold mb-3">Ready to Build?</p>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
                Let's Ship Your Next C# Project.
            </h2>
            <p class="text-slate-300 text-base sm:text-lg max-w-xl mx-auto mb-8">
                Need a cross-platform desktop app, an ASP.NET Core API, or a quick fix on an existing .NET codebase? Reach out directly and get a clear scope and timeline.
            </p>

            <!-- Direct Email Box + Copy & Send Actions -->
            <div class="inline-flex flex-col sm:flex-row items-center gap-3 p-2.5 rounded-2xl bg-navy-950/80 border border-white/10 max-w-full mb-8">
                <span id="emailAddress" class="px-4 py-2 font-mono text-sm sm:text-base text-brand-cyan select-all break-all">
                    @Email
                </span>
                <div class="flex items-center gap-2 w-full sm:w-auto justify-center">
                    <button id="copyEmailBtn" type="button"
                            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-navy-800 hover:bg-navy-700 border border-white/10 text-white text-sm font-semibold transition-all active:scale-95"
                            @onclick="CopyEmailToClipboard">
                        <svg class="w-4 h-4 text-brand-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                        <span id="copyBtnLabel">@_copyLabel</span>
                    </button>
                    <a href="mailto:@Email?subject=Project%20Inquiry%20%E2%80%94%20ShipSharp.net"
                       class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-brand-cyan to-brand-magenta text-navy-950 text-sm font-bold hover:opacity-95 active:scale-95 transition-all">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                        Send Email
                    </a>
                </div>
            </div>

            <!-- Social / Freelance Profile Links -->
            <div class="flex flex-wrap items-center justify-center gap-4">
                <!-- GitHub -->
                <a href="https://github.com/ShipSharpDotnet" target="_blank" rel="noopener noreferrer" aria-label="ShipSharp GitHub Profile"
                   class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-navy-900/90 border border-white/10 text-slate-300 hover:text-white hover:border-brand-cyan/50 text-sm font-medium transition-all">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                    </svg>
                    GitHub
                </a>

                <!-- LinkedIn -->
                <a href="https://www.linkedin.com/in/shipsharp-dotnet/" target="_blank" rel="noopener noreferrer" aria-label="ShipSharp LinkedIn Profile"
                   class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-navy-900/90 border border-white/10 text-slate-300 hover:text-white hover:border-brand-cyan/50 text-sm font-medium transition-all">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M19 3a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h14m-.5 15.5v-5.3a3.26 3.26 0 00-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 011.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 001.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 00-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
                    </svg>
                    LinkedIn
                </a>

                <!-- Fiverr -->
                <a href="https://www.fiverr.com/shipsharp" target="_blank" rel="noopener noreferrer" aria-label="ShipSharp Fiverr Profile"
                   class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-navy-900/90 border border-white/10 text-slate-300 hover:text-white hover:border-brand-mint/50 text-sm font-medium transition-all">
                    <svg class="w-5 h-5 text-brand-mint" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    Fiverr
                </a>
            </div>
        </div>
    </div>
</section>

<!-- ========================================================= -->
<!-- TOAST NOTIFICATION (Clipboard Feedback)                   -->
<!-- ========================================================= -->
<div id="toast" class="@ToastClass">
    <div class="flex items-center gap-3 px-5 py-3.5 rounded-xl bg-navy-800 border border-brand-mint/40 shadow-2xl text-sm font-medium text-white">
        <span class="w-2.5 h-2.5 rounded-full bg-brand-mint"></span>
        <span id="toastMessage">@_toastMessage</span>
    </div>
</div>

@code {
    private const string Email = "shipsharp.net@gmail.com";

    private string _copyLabel = "Copy Email";
    private string _toastMessage = "Copied to clipboard!";
    private bool _toastVisible;
    private CancellationTokenSource? _toastCts;

    private string ToastClass => _toastVisible
        ? "fixed bottom-6 right-6 z-50 translate-y-0 opacity-100 transition-all duration-300"
        : "fixed bottom-6 right-6 z-50 translate-y-20 opacity-0 pointer-events-none transition-all duration-300";

    private async Task CopyEmailToClipboard()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Email);
            await ShowToastAsync("Copied to clipboard!");
            _copyLabel = "Copied!";
        }
        catch
        {
            await ShowToastAsync("Select and copy: " + Email);
        }

        _ = ResetCopyLabelAsync();
    }

    private async Task ShowToastAsync(string message)
    {
        _toastMessage = message;
        _toastVisible = true;

        _toastCts?.Cancel();
        _toastCts = new CancellationTokenSource();
        var token = _toastCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(2600, token);
            }
            catch (OperationCanceledException)
            {
                return;
            }

            await InvokeAsync(() =>
            {
                _toastVisible = false;
                StateHasChanged();
            });
        }, token);
    }

    private async Task ResetCopyLabelAsync()
    {
        await Task.Delay(2200);
        await InvokeAsync(() =>
        {
            _copyLabel = "Copy Email";
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _toastCts?.Cancel();
        _toastCts?.Dispose();
    }
}
