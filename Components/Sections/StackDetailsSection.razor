<!-- ========================================================= -->
<!-- SKILLS IN DETAIL (from the Kelenna portfolio)              -->
<!-- ========================================================= -->
<section class="pt-4 pb-20 sm:pb-24 border-t border-white/5">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mb-12">
            <p class="font-mono text-xs sm:text-sm uppercase tracking-widest text-brand-cyan font-semibold mb-2">What I Actually Do</p>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-3">
                Built Across Desktop, Web, Mobile &amp; Games
            </h2>
            <p class="text-slate-400 text-base sm:text-lg leading-relaxed">
                I'm Kelenna Kennedy Okere, a software developer and creator focused on practical, fast, and interesting software. I primarily work with C# and .NET across desktop, mobile, web, and games, and I like learning by actually building things.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
            @foreach (var group in SkillGroups)
            {
                <div class="group rounded-2xl bg-navy-800/60 backdrop-blur-md border border-white/10 p-7 hover:border-brand-cyan/40 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 rounded-xl @group.IconClasses flex items-center justify-center mb-6 group-hover:scale-105 transition-transform">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@group.Icon" />
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-white mb-3">@group.Title</h3>
                        <p class="text-slate-300 text-sm leading-relaxed mb-6">@group.Description</p>
                    </div>
                    <div class="flex flex-wrap gap-2 pt-4 border-t border-white/10 font-mono text-xs">
                        @foreach (var skill in group.Skills)
                        {
                            <span class="px-2.5 py-1 rounded-lg @group.ChipClasses">@skill</span>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="mt-10 rounded-2xl bg-navy-950/60 border border-white/10 p-7 sm:p-9 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
            <div>
                <p class="font-mono text-xs uppercase tracking-widest text-brand-mint font-semibold mb-2">How I Work</p>
                <p class="text-slate-200 text-base sm:text-lg leading-relaxed max-w-2xl">
                    "My goal isn't to use the most complicated technology available. It's to make the thing work, make it right, and then make it fast."
                </p>
            </div>
            <NavLink href="/contact" class="shrink-0 inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-brand-cyan to-brand-magenta text-navy-950 font-bold text-sm shadow-glow-cyan hover:opacity-95 active:scale-95 transition-all">
                Start a Project
            </NavLink>
        </div>
    </div>
</section>

