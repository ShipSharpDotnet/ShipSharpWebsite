@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@implements IDisposable

<!-- Ambient Background Glows -->
<div class="fixed inset-0 pointer-events-none overflow-hidden -z-10" aria-hidden="true">
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-brand-cyan/15 rounded-full blur-3xl"></div>
    <div class="absolute top-1/4 -right-32 w-96 h-96 bg-brand-magenta/15 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-1/3 w-80 h-80 bg-brand-mint/10 rounded-full blur-3xl"></div>
</div>

<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:rounded-xl focus:bg-navy-800 focus:text-white">Skip to content</a>

<div class="min-h-screen flex flex-col">
<!-- ========================================================= -->
<!-- STICKY NAVIGATION BAR                                      -->
<!-- ========================================================= -->
<header class="sticky top-0 z-40 bg-navy-900/80 backdrop-blur-xl border-b border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 sm:h-20">
            <!-- Brand Logo -->
            <NavLink href="/" Match="NavLinkMatch.All" class="flex items-center gap-3 group focus:outline-none">
                <div class="w-10 h-10 rounded-xl bg-navy-800 border border-white/10 flex items-center justify-center shadow-lg group-hover:border-brand-cyan/50 transition-colors overflow-hidden">
                    <img src="images/logo.webp" alt="ShipSharp.net logo" class="w-full h-full object-cover" />
                </div>
                <span class="text-xl font-extrabold tracking-tight">
                    <span class="text-white">Ship</span><span class="bg-gradient-to-r from-brand-cyan via-brand-mint to-brand-magenta bg-clip-text text-transparent">Sharp</span><span class="text-slate-400 font-mono text-base font-medium">.net</span>
                </span>
            </NavLink>

            <!-- Desktop Navigation Links -->
            <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
                <NavLink href="/services" class="hover:text-brand-cyan transition-colors py-2">Services</NavLink>
                <NavLink href="/projects" class="hover:text-brand-cyan transition-colors py-2">Projects</NavLink>
                <NavLink href="/stack" class="hover:text-brand-cyan transition-colors py-2">Stack</NavLink>
                <NavLink href="/contact" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-brand-cyan to-brand-magenta text-navy-950 font-semibold shadow-glow-cyan hover:opacity-95 active:scale-95 transition-all">
                    Hire Me
                </NavLink>
            </nav>

            <!-- Mobile Menu Toggle Button -->
            <button type="button" aria-label="Toggle Navigation Menu" aria-expanded="@_mobileMenuOpen.ToString().ToLowerInvariant()"
                    class="md:hidden p-2.5 rounded-xl bg-navy-800/80 border border-white/10 text-slate-200 hover:border-brand-cyan/40 transition-colors"
                    @onclick="ToggleMobileMenu">
                <svg class="w-6 h-6 @(!_mobileMenuOpen ? "" : "hidden")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
                <svg class="w-6 h-6 @(_mobileMenuOpen ? "" : "hidden")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
    </div>

    <!-- Mobile Navigation Drawer -->
    <div class="@MobileMenuClass">
        <div class="px-4 pt-3 pb-5 space-y-2">
            <NavLink href="/services" class="mobile-nav-link block px-4 py-3 rounded-xl text-slate-200 hover:bg-navy-800 hover:text-brand-cyan font-medium transition-colors">Services</NavLink>
            <NavLink href="/projects" class="mobile-nav-link block px-4 py-3 rounded-xl text-slate-200 hover:bg-navy-800 hover:text-brand-cyan font-medium transition-colors">Projects</NavLink>
            <NavLink href="/stack" class="mobile-nav-link block px-4 py-3 rounded-xl text-slate-200 hover:bg-navy-800 hover:text-brand-cyan font-medium transition-colors">Stack</NavLink>
            <NavLink href="/contact" class="mobile-nav-link block px-4 py-3 rounded-xl text-center bg-gradient-to-r from-brand-cyan to-brand-magenta text-navy-950 font-bold mt-2">
                Hire Me
            </NavLink>
        </div>
    </div>
</header>

<main id="main-content" class="flex-1">
    @Body
</main>

<!-- ========================================================= -->
<!-- FOOTER                                                    -->
<!-- ========================================================= -->
<footer class="border-t border-white/10 py-8 bg-navy-950/60">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-slate-400">
        <p>&copy; @DateTime.UtcNow.Year <span class="text-white font-semibold">ShipSharp.net</span> &mdash; Built with precision.</p>
        <div class="flex items-center gap-6 font-mono text-xs">
            <NavLink href="/services" class="hover:text-brand-cyan transition-colors">Services</NavLink>
            <NavLink href="/projects" class="hover:text-brand-cyan transition-colors">Projects</NavLink>
            <NavLink href="/contact" class="hover:text-brand-cyan transition-colors">Contact</NavLink>
        </div>
    </div>
</footer>
</div>

@code {
    private bool _mobileMenuOpen;

    private string MobileMenuClass => _mobileMenuOpen
        ? "md:hidden border-t border-white/10 bg-navy-900/95 backdrop-blur-xl"
        : "hidden md:hidden border-t border-white/10 bg-navy-900/95 backdrop-blur-xl";

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _mobileMenuOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private void ToggleMobileMenu() => _mobileMenuOpen = !_mobileMenuOpen;

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
